#!/bin/sh
# Rejects commit messages that do not follow the team's Conventional Commits rules.
# Enable once per clone: git config core.hooksPath .githooks

message_file="$1"
subject=$(sed -n '1p' "$message_file" | tr -d '\r')

case "$subject" in
  "Merge "*|"Revert \""*|"fixup! "*|"squash! "*) exit 0 ;;
esac

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9]+(-[a-z0-9]+)*\))?!?: [a-z0-9`].*[^.[:space:]]$'

if ! printf '%s\n' "$subject" | grep -Eq "$pattern"; then
  echo "Invalid commit message: \"$subject\"" >&2
  echo "Expected: <type>(<scope>): <lowercase imperative summary without a trailing period>" >&2
  echo "Types: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert" >&2
  echo "Example: feat(cattle-information): add lot assignment endpoint" >&2
  exit 1
fi

if [ "${#subject}" -gt 72 ]; then
  echo "Commit summary is ${#subject} characters long; keep it within 72." >&2
  exit 1
fi
